generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entityType String  @map("entity_type")
  entityId  Int      @map("entity_id")
  userId    Int?     @map("user_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Image {
  id                  Int      @id @default(autoincrement())
  source              String?
  query               String?
  url                 String?  @unique
  localPath           String?  @map("local_path")
  collectedAt         String?  @map("collected_at")
  faceDetected        Int?     @default(0) @map("face_detected")
  faceCount           Int?     @default(0) @map("face_count")
  faceMatch           Int?     @default(0) @map("face_match")
  faceMatchScore      Float?   @default(0.0) @map("face_match_score")
  faceMatchDistance   Float?   @map("face_match_distance")
  bestReferencePath   String?  @default("") @map("best_reference_path")
  imageHash           String?  @map("image_hash")
  notes               String?
  tags                String?

  // Digital-library photo facets (Year → Event → Location → Person → Institution → Parliament → Theme)
  dateTaken           String?  @map("date_taken")
  year                Int?
  event               String?
  location            String?
  person              String?
  institution         String?
  parliament          String?
  theme               String?
  caption             String?
  curated             Boolean  @default(false)

  @@index([source])
  @@index([collectedAt])
  @@index([year])
  @@index([curated])
  @@map("images")
}

model ArchiveItem {
  id          Int      @id @default(autoincrement())
  kind        String
  title       String
  slug        String   @unique
  date        String?
  year        Int?
  event       String?
  location    String?
  person      String?
  institution String?
  parliament  String?
  theme       String?
  venue       String?
  source      String?
  sourceUrl   String?
  sourceType  String   @default("unverified") @map("source_type")
  excerpt     String?
  body        String?
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  coverUrl    String?  @map("cover_url")
  occasion    String?
  videoUrl    String?  @map("video_url")
  audioUrl    String?  @map("audio_url")
  photoUrl    String?  @map("photo_url")
  featured    Boolean  @default(false)
  status      String   @default("published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([kind])
  @@index([status])
  @@index([year])
  @@map("archive_items")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  author    String
  role      String?
  quote     String
  source    String?
  year      Int?
  photoUrl  String?  @map("photo_url")
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("published")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model Milestone {
  id          Int      @id @default(autoincrement())
  year        String
  period      String?
  title       String
  description String?
  category    String   @default("career")
  order       Int      @default(0)
  status      String   @default("published")
  imageUrl    String?  @map("image_url")
  imageAlt    String?  @map("image_alt")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("milestones")
}

model Video {
  id          Int      @id @default(autoincrement())
  source      String?
  platform    String?
  title       String?
  url         String?  @unique
  channel     String?
  duration    Int?
  views       Int?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  notes       String?
  tags        String?

  // Digital-library video facets
  category  String?
  caption   String?
  date      String?
  year      Int?
  event     String?
  location  String?
  theme     String?
  featured  Boolean  @default(false)
  status    String   @default("published")

  @@index([source])
  @@index([platform])
  @@index([collectedAt])
  @@index([category])
  @@index([year])
  @@index([status])
  @@map("videos")
}

model News {
  id          Int      @id @default(autoincrement())
  source      String?
  query       String?
  title       String?
  url         String?  @unique
  sourceName  String?  @map("source_name")
  date        String?
  snippet     String?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  rawHtml     String?  @map("raw_html")
  notes       String?
  tags        String?
  researchEventLinks ResearchEventNews[]

  @@index([source])
  @@index([sourceName])
  @@index([date])
  @@index([collectedAt])
  @@map("news")
}

model Audio {
  id          Int      @id @default(autoincrement())
  source      String?
  query       String?
  title       String?
  url         String?  @unique
  artist      String?
  duration    String?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  notes       String?
  tags        String?

  // Digital-library audio facets
  category  String?
  caption   String?
  date      String?
  year      Int?
  event     String?
  location  String?
  theme     String?
  featured  Boolean  @default(false)
  status    String   @default("published")

  @@index([source])
  @@index([artist])
  @@index([collectedAt])
  @@index([category])
  @@index([year])
  @@index([status])
  @@map("audio")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?  @unique
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  role      String   @default("viewer") @map("role")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  read      Boolean  @default(false) @map("read")
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model ContentSection {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String?
  body      String?
  data      String?
  status    String   @default("published")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_sections")
}

model ContentPage {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  body        String    @default("")
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("content_pages")
}

model ResearchDataset {
  id         String           @id
  title      String
  accessedDate String         @map("accessed_date")
  cutoffDate String           @map("cutoff_date")
  subject    Json
  coverage   Json
  sources    ResearchSource[]
  events     ResearchEvent[]
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")

  @@map("research_datasets")
}

model ResearchSource {
  recordId           String                @id @map("record_id")
  datasetId          String                @map("dataset_id")
  title              String
  originalUrl        String                @map("original_url")
  downloadUrl        String?               @map("download_url")
  publicationDate    String?               @map("publication_date")
  sittingDate        String?               @map("sitting_date")
  accessedDate       String                @map("accessed_date")
  documentType       String                @map("document_type")
  termOrSession      String?               @map("term_or_session")
  persons            Json
  locator            String?
  summary            String
  relevance          String
  verificationStatus String                @map("verification_status")
  notes              String?
  dataset            ResearchDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  eventLinks         ResearchEventSource[]

  @@unique([datasetId, originalUrl])
  @@index([datasetId])
  @@index([verificationStatus])
  @@map("research_sources")
}

model ResearchEvent {
  eventId          String                @id @map("event_id")
  datasetId        String                @map("dataset_id")
  startDate        String?               @map("start_date")
  endDate          String?               @map("end_date")
  type             String
  description      String
  attribution      String
  evidenceStatus   String                @map("evidence_status")
  notes            String?
  dataset          ResearchDataset       @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sourceLinks      ResearchEventSource[]
  newsLinks        ResearchEventNews[]

  @@index([datasetId, startDate])
  @@map("research_events")
}

model ResearchEventSource {
  eventId  String         @map("event_id")
  recordId String         @map("record_id")
  event    ResearchEvent  @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  source   ResearchSource @relation(fields: [recordId], references: [recordId], onDelete: Cascade)

  @@id([eventId, recordId])
  @@index([recordId])
  @@map("research_event_sources")
}


model ResearchEventNews {
  eventId String        @map("event_id")
  newsId  Int           @map("news_id")
  event   ResearchEvent @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  news    News          @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([eventId, newsId])
  @@index([newsId])
  @@map("research_event_news")
}
