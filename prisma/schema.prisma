generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entityType String  @map("entity_type")
  entityId  Int      @map("entity_id")
  userId    Int?     @map("user_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Image {
  id                  Int      @id @default(autoincrement())
  source              String?
  query               String?
  url                 String?  @unique
  localPath           String?  @map("local_path")
  collectedAt         String?  @map("collected_at")
  faceDetected        Int?     @default(0) @map("face_detected")
  faceCount           Int?     @default(0) @map("face_count")
  faceMatch           Int?     @default(0) @map("face_match")
  faceMatchScore      Float?   @default(0.0) @map("face_match_score")
  faceMatchDistance   Float?   @map("face_match_distance")
  bestReferencePath   String?  @default("") @map("best_reference_path")
  imageHash           String?  @map("image_hash")
  notes               String?
  tags                String?

  // Digital-library photo facets (Year → Event → Location → Person → Institution → Parliament → Theme)
  dateTaken           String?  @map("date_taken")
  year                Int?
  event               String?
  location            String?
  person              String?
  institution         String?
  parliament          String?
  theme               String?
  caption             String?
  curated             Boolean  @default(false)

  @@index([source])
  @@index([collectedAt])
  @@index([year])
  @@index([curated])
  @@map("images")
}

model ArchiveItem {
  id          Int      @id @default(autoincrement())
  kind        String
  title       String
  slug        String   @unique
  date        String?
  year        Int?
  event       String?
  location    String?
  person      String?
  institution String?
  parliament  String?
  theme       String?
  venue       String?
  source      String?
  sourceUrl   String?
  sourceType  String   @default("unverified") @map("source_type")
  excerpt     String?
  body        String?
  filePath    String?  @map("file_path")
  fileName    String?  @map("file_name")
  coverUrl    String?  @map("cover_url")
  featured    Boolean  @default(false)
  status      String   @default("published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([kind])
  @@index([status])
  @@index([year])
  @@map("archive_items")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  author    String
  role      String?
  quote     String
  source    String?
  year      Int?
  photoUrl  String?  @map("photo_url")
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("published")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model Milestone {
  id          Int      @id @default(autoincrement())
  year        String
  period      String?
  title       String
  description String?
  category    String   @default("career")
  order       Int      @default(0)
  status      String   @default("published")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("milestones")
}

model Video {
  id          Int      @id @default(autoincrement())
  source      String?
  platform    String?
  title       String?
  url         String?  @unique
  channel     String?
  duration    Int?
  views       Int?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  notes       String?
  tags        String?

  @@index([source])
  @@index([platform])
  @@index([collectedAt])
  @@map("videos")
}

model News {
  id          Int      @id @default(autoincrement())
  source      String?
  query       String?
  title       String?
  url         String?  @unique
  sourceName  String?  @map("source_name")
  date        String?
  snippet     String?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  notes       String?
  tags        String?

  @@index([source])
  @@index([sourceName])
  @@index([date])
  @@index([collectedAt])
  @@map("news")
}

model Audio {
  id          Int      @id @default(autoincrement())
  source      String?
  query       String?
  title       String?
  url         String?  @unique
  artist      String?
  duration    String?
  collectedAt String?  @map("collected_at")
  localPath   String?  @map("local_path")
  notes       String?
  tags        String?

  @@index([source])
  @@index([artist])
  @@index([collectedAt])
  @@map("audio")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?  @unique
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  role      String   @default("viewer") @map("role")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  read      Boolean  @default(false) @map("read")
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model ContentSection {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String?
  body      String?
  data      String?
  status    String   @default("published")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_sections")
}

model ContentPage {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  body        String    @default("")
  status      String    @default("draft")
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("content_pages")
}
